# --- App ---
APP_NAME=credit-ai-backend
ENV=development
DEBUG=true

# --- DB ---
#DATABASE_URL=postgresql+psycopg2://creditai:creditai@localhost:5432/creditai

# --- Neon DB (paste your string, add the driver prefix) ---
DATABASE_URL=postgresql+psycopg2://creditai_owner:npg_XXXX@ep-xxxxx-pooler.us-east-2.aws.neon.tech/credit-ai?sslmode=require

# --- JWT ---
JWT_SECRET=change-me-in-prod-please-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MIN=60

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=600
#
OPENAI_API_KEY=gsk_paste_your_groq_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.1-8b-instant
OPENAI_MAX_TOKENS=600
# --- OCR ---
TESSERACT_CMD=/usr/bin/tesseract
